{
  "manifest_version": 3,
  "name": "catCloner",
  "version": "4.3.2",
  "version_name": "4.3.2",
  "description": "Create private, navigable visual snapshots for offline browsing",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icons": {
      "16": "icons/icon-1.png",
      "24": "icons/icon-2.png",
      "32": "icons/icon-3.png",
      "48": "icons/icon-4.png",
      "64": "icons/icon-5.png",
      "96": "icons/icon-6.png",
      "128": "icons/icon-7.png",
      "256": "icons/icon-8.png"
    }
  },
  "icons": {
    "16": "icons/icon-1.png",
    "24": "icons/icon-2.png",
    "32": "icons/icon-3.png",
    "48": "icons/icon-4.png",
    "64": "icons/icon-5.png",
    "96": "icons/icon-6.png",
    "128": "icons/icon-7.png",
    "256": "icons/icon-8.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
